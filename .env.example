# Backend environment variables — Railway/Render'da sozlang
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
PORT=5000
JWT_SECRET="kamida_32_ta_belgidan_iborat_maxfiy_kalit_bu_yerda"
NODE_ENV=production

# CORS — Frontend va Admin URL'lari
CLIENT_URL="https://your-app.vercel.app"
